source "https://rubygems.org"

# Mirrors what GitHub Pages builds with, so local preview matches production.
gem "github-pages", group: :jekyll_plugins

# Lock to the Pages-supported Jekyll line.
gem "jekyll", "~> 3.10"

group :jekyll_plugins do
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
end

# Needed on Ruby 3.x (no longer bundled with the stdlib).
gem "webrick"
